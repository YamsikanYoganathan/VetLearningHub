# ============================================================================
# VETERINARY LEARNING HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy or rename this file to .env.local and fill in your Supabase credentials
# from the Supabase Dashboard -> Project Settings -> API.
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service Role Key (Only use in secure server-side environments / API routes, NEVER expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
